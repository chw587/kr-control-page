	jQuery.fn.serializeObject = function () {
		var result = {};
		let serializeArray;
	    
	    try{
	        if( $(this)[0].nodeName == 'FORM'){ 
	        	serializeArray = this.serializeArray();
	        } else { 
	        	serializeArray = $(this)[0].children; 
	        }
	    }catch(element){ 
	    	return result; 
	    }
		
		
		jQuery.each(serializeArray, function (i, element) {
			var node = result[element.name];
			if (typeof node !== 'undefined' && node !== null) {
				if (jQuery.isArray(node)) {
					node.push(element.value.replace(/(?:\r\n|\r|\n)/g, '<br>').replace(/,/g,'&#44;').replace(/"/g, '&quot;'));
				} else {
					result[element.name] = [node, element.value.replace(/(?:\r\n|\r|\n)/g, '<br>').replace(/,/g,'&#44;').replace(/"/g, '&quot;')];
				}
			} else {
				result[element.name] = element.value.replace(/(?:\r\n|\r|\n)/g, '<br>').replace(/,/g,'&#44;').replace(/"/g, '&quot;');
			}
			//console.log(element.name +"="+ result[element.name]);
		});
		return result;
	};
	
