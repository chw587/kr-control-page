	/* 주어진 문장안에 특수기호 관련 태그를 webfont로 사용하도록 태그 변경 */
	,getConvertWebFont(str){
		if(str != undefined && str.length > 0) {
			if(str.indexOf("&lt;equ&gt;") > -1) {
				str = str.replace(/&lt;equ&gt;/g, "<equ>").replace(/&lt;sh;equ&gt;/g, "</equ>").replace(/&amp;/g, "&");
				str = str.replace(/&lt;hanja&gt;/g, "<hanja>").replace(/&lt;sh;hanja&gt;/g, "</hanja>").replace(/&amp;/g, "&");
			}
			str = str.replace(/&lt;/g, "<").replace(/&gt;/g, ">").replace(/&amp;/g, "&");
		}
		str = str.replace(/<equ>/ig, '<span class="korean-webfont">').replace(/<\/equ>/ig, '</span>');
		return str;
	}
};


//분야선택
function initBranchSelect() {
    var branchSelect = $(".branch_select");
    var bsList = branchSelect.find(".bs_list");
    var allSelect = bsList.find("p.all_select>span.checkbox>input[type='checkbox']");
    var bsDeps1 = bsList.find(">ul>li");
    var bsDeps2 = bsDeps1.find("ul>li");
    
    bsDeps1.find("button").on("click",function() {
        if($(this).hasClass("active") == false) {
            $(this).addClass("active")
            $(this).next().show();
        } else if($(this).hasClass("active") == true) {
            $(this).removeClass("active")
            $(this).next().hide();
        }
    })
    
    allSelect.on("click",function() {
        if($(this).is(":checked") == true) {
            bsList.find("span.checkbox>input[type='checkbox']").prop("checked",true);
        } else {
            bsList.find("span.checkbox>input[type='checkbox']").prop("checked",false);
        }
    })
    
    bsDeps1.find("span.checkbox input[type='checkbox']").on("change",function() {
        if($(this).is(":checked") == true) {
            $(this).parent().parent().find("ul>li>span.checkbox>input[type='checkbox']").prop("checked",true);
        } else {
            $(this).parent().parent().find("ul>li>span.checkbox>input[type='checkbox']").prop("checked",false);
            allSelect.prop("checked",false);
        }
    })
    
    bsDeps2.find("span.checkbox input[type='checkbox']").on("change",function() {
        if($(this).is(":checked") == false) {
            $(this).parent().parent().parent().parent().find(">span.checkbox input[type='checkbox']").prop("checked",false);
            allSelect.prop("checked",false);
        }
    })
}

