	,realm : {
		trgetEvent : ''
		,targetThis : ''
		,targetType : ''
		,getRealmSelectView : function(oThis, event, type){
			this.trgetEvent = event;
			this.targetThis = oThis;
			this.targetType = type;
			$.ajax({
				url : '/common/getRealmSelectView.do'
				,type : 'post'
				,datType : 'json'
				,data : {type : type}
				,success : function(resData) {
					var popupContainer = $(document).find('div.popup_container');
					if($(popupContainer).size() <= 0){
						$(oThis).closest('form').after('<div id="dynamicPopupContainer" class="popup_container"><div id="selectRealmFormWrapper"></div></div>');
					} else {
						popupContainer.append('<div id="selectRealmFormWrapper"></div>');
					}
					$('#selectRealmFormWrapper').append(resData);
					common.modalPopShow('#realmSelectLayerPopup', '780', false);
				}
				,error: function (xhr, ajaxOptions, thrownError) {
					alert("오류가 발생하였습니다.");
				}
				,complete : function(){
					initBranchSelect();
				}
			});
		}
	}
	
