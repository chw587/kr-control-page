//정렬(위)
function fnSortUp(keyName, seq){
	var o  = $("#"+keyName+"Row"+seq);
	//alert(o);
	//최상위 여부 판단(데이타 형식 비교)
    if(o.prev().get(0) !== undefined){
        //순서 이동시 이전값을 유지하기 위해서
    	o.find("input[name$=Prev]").each(function(){
    		var name = $(this).attr("name");
    		
    		var o_value = $(this).val();
    		var o_pre_value = o.prev().find("input[name="+name+"]").val(); 
    		
    		$(this).val(o_pre_value);
    		o.prev().find("input[name="+name+"]").val(o_value);
    	});
    	
    	o.find("textarea[name$=Prev]").each(function(){
    		var name = $(this).attr("name");
    		
    		var o_value = $(this).val();
    		var o_pre_value = o.prev().find("textarea[name="+name+"]").val(); 
    		
    		$(this).val(o_pre_value);
    		o.prev().find("textarea[name="+name+"]").val(o_value);
    	});

    	o.cloneData(true).attr("id","changeData").insertBefore(o.prev());
    	
        $("#"+keyName+"Row"+seq).remove();
        
        $("#changeData").attr("id",keyName+"Row"+seq);
    }
}

//정렬(아래)
function fnSortDown(keyName, seq){
	var o = $("#"+keyName+"Row"+seq);
  
	//최하위 여부 판단(데이타 형식 비교)
    if(o.next().get(0) !== undefined){
    	//순서 이동시 이전값을 유지하기 위해서
    	o.find("input[name$=Prev]").each(function(){
    		
    		var name = $(this).attr("name");
			
			var o_value = $(this).val();
			var o_next_value = o.prev().find("input[name="+name+"]").val(); 
			
			$(this).val(o_next_value);
			o.next().find("input[name="+name+"]").val(o_value);
    	});
    	
    	o.find("textarea[name$=Prev]").each(function(){
    		
    		var name = $(this).attr("name");
			
			var o_value = $(this).val();
			var o_next_value = o.prev().find("textarea[name="+name+"]").val(); 
			
			$(this).val(o_next_value);
			o.next().find("textarea[name="+name+"]").val(o_value);
    	});

    	o.cloneData(true).attr("id","changeData").insertAfter(o.next());
        
    	$("#"+keyName+"Row"+seq).remove();
        
    	$("#changeData").attr("id",keyName+"Row"+seq);
    }
}


