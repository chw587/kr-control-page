	,windowOpen : function(oThis, pageUrl, pageTitle, returnTargetId){
		var findParams = $(oThis).data();
		var createUniqueName;
		if(pageTitle){
			createUniqueName = pageTitle+'_'+date.getCurrentTime();
			$('#'+returnTargetId+'').trigger("focus");
		} else {
			createUniqueName = '작업 이력 보기_'+date.getCurrentTime();
		}
		
		var formObj = $('<form id="dynamicSpecialCharForm"></form>');
		$(formObj).attr('action', pageUrl);
		$(formObj).attr('target', createUniqueName);
		$(formObj).attr('method', 'post');
		$(formObj).appendTo('body');
		$(formObj).append('<input type="hidden" name="returnTargetId" value="'+returnTargetId+'" />');
		for(var property in findParams){
			$(formObj).append('<input type="hidden" name="'+property+'" value="'+findParams[property]+'" />');
		}
		
		window.open('', createUniqueName, 'width=1024, height=768, left=20, top=20, toolbar=no, menubar=no, scrollbars=no, resizable=yes, location=no');
		$(formObj).submit();
	}
