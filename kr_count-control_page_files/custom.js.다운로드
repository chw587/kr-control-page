
var form = {
	clear : function(formId){
		var currentForm = $("#"+formId);

		var inputElement = currentForm.find("input").not(".no_clear");
		var selectElement = currentForm.find("select").not(".no_clear");
		var textareaElement = currentForm.find("textarea").not(".no_clear");
		var spanElement = currentForm.find("td > span").not(".no_clear");

		for(var i = 0; i < inputElement.length; i++){
			if(inputElement[i].type == "checkbox" || inputElement[i].type == "radio"){
				if($(inputElement[i]).val() == ''){
					$(inputElement[i]).prop("checked", true);
				} else {
					$(inputElement[i]).prop("checked", false);
				}
			}else{
				$(inputElement[i]).val("");
			}
		}

		for(var i = 0; i < selectElement.length; i++){
			$(selectElement[i]).find("option:eq(0)").prop("selected", true);
		}

		for(var i = 0; i < textareaElement.length; i++){
			$(textareaElement[i]).val("");
		}

		for(var i = 0; i < spanElement.length; i++){
			$(spanElement[i]).html("");
		}
	}
	,enable : function(formId){
		var currentForm = $("#"+formId);

		var inputElement = currentForm.find("input");
		var selectElement = currentForm.find("select");
		var textareaElement = currentForm.find("textarea");

		for(var i = 0; i < inputElement.length; i++){
			$(inputElement[i]).prop("readonly", false);
		}

		for(var i = 0; i < selectElement.length; i++){
			$(selectElement[i]).prop("disabled", false);
		}

		for(var i = 0; i < textareaElement.length; i++){
			$(textareaElement[i]).prop("readonly", false);
		}

	}
	,disable : function(formId){
		var currentForm = $("#"+formId);

		var inputElement = currentForm.find("input");
		var selectElement = currentForm.find("select");
		var textareaElement = currentForm.find("textarea");

		for(var i = 0; i < inputElement.length; i++){
			$(inputElement[i]).prop("readonly", true);
		}

		for(var i = 0; i < selectElement.length; i++){
			$(selectElement[i]).prop("disabled", true);
		}

		for(var i = 0; i < textareaElement.length; i++){
			$(textareaElement[i]).prop("readonly", true);
		}
	}
	, isValidate : function(formId){
		var result = true;
		var message = "";
		$("#" + formId).find(".required").each(function(){
			if($(this).prop("type")== "checkbox" || $(this).prop("type")== "radio"){
				if($("[name="+$(this).prop("name")+"]:checked").length == 0){
					$(this).focus();
					message = $(this).prop("title") + "(을)를 선택해 주세요!";
					result = false;
					return false;
				}
			}
			if($(this).prop("type")== "select"){
				if($.trim($(this).val()) != ""){
					if(!$.isNumeric($(this).val())){
						$(this).focus();
						message = $(this).prop("title") + "(을)를 선택해 주세요!";
						result = false;
						return false;
					}
				}
			}
			
			if($(this).val() == ""){
				$(this).focus();
				message = $(this).prop("title") + "(을)를 입력해 주세요!";
				result = false;
				return false;
			}
		});
		
		
		$("#" + formId).find(".numeric").each(function(){
			if($.trim($(this).val()) != ""){
				if(!$.isNumeric($(this).val())){
					$(this).focus();
					message = $(this).prop("title") + "(을)를 숫자로 입력해 주세요!";
					result = false;
					return false;
				}
			}
		})
		
		if(message != ""){
			alert(message);
		}
		return result;
	}
};

var format = {
	dateStr : function(val){
		if(val != null && val != "" && val != undefined){
			return val.replace(/([0-9]{2})([0-9]{2})([0-9]{4})/,"$1/$2/$3");
		}else{
			return "";
		}
	}
	,date : function(val){
		if(val != null && val != "" && val != undefined){
			var dateTime = Date.create(val);
			return dateTime.format('{dd}/{MM}/{yyyy}');
		}else{
			return "";
		}
	}
	,timestamp : function(val){
		if(val != null && val != "" && val != undefined){
			var dateTime = Date.create(val);
			return dateTime.format('{dd}/{MM}/{yyyy} {HH}:{mm}:{ss}');
		}else{
			return "";
		}
	}
	,num : function(n){
		  var reg = /(^[+-]?\d+)(\d{3})/;   // 정규식
		  n += '';                          // 숫자를 문자열로 변환

		  while (reg.test(n))
		    n = n.replace(reg, '$1' + ',' + '$2');

		  return n;
	}
	/**	3자리 단위마다 콤마 생성 */ 
	, addCommas : function(x){
		return x.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",");	
	}
	/**	모든 콤마 제거 */
	, removeCommas : function(x){
		if(!x || x.length == 0)
			return "";
	    else
			return x.split(",").join("");	
	}
	/** key 이벤트에 숫자만 입력하게 체크 */
	, numkeyCheck : function(obj) {
		$(obj).val($(obj).val().replace(/[^\d]/g, ''));
	}

};


