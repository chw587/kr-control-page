/**
 * Ajax 관련함수
 */
var ajax = {
	call : function(options){
//		spin.start();
		
		jQuery.ajaxSettings.traditional = true;
		
		options.type = options.type || "POST";
		options.dataType = options.dataType || "json";
		
		if(options.contentType == undefined)
			options.contentType = "application/x-www-form-urlencoded;charset=UTF-8";
			
		if(options.processData == undefined)
			options.processData = true;
			
		if(options.enctype == undefined)
			options.enctype = "application/x-www-form-urlencoded";
			
		if(options.async == undefined)
			options.async = true;
			
		$.ajax({
			url : options.url,
			type : options.type,
			enctype : options.enctype,
			dataType : options.dataType,
			async : options.async, 
			processData : options.processData,
			contentType : options.contentType,
			data : options.data
		})
		.done(function(data, textStatus, jqXHR){
			if(data.exCode != null || data.exCode != undefined){
				if(options.fail != undefined){
					options.fail(data);
				}

				alert(data.exMsg);
			}else{
				options.done(data);
			}
		})
		.fail(function( jqXHR, textStatus, errorThrown ){
			if(options.fail != undefined){
				options.fail();
			}

			exception(jqXHR.status);
		})
		.always(function(){
//			spin.stop();
		})
		.then(function(data, textStatus, jqXHR ) {
		});
	}
	,load : function(targetId, url, params, popupYn){
		
		if(params == undefined){
			params = {};
		}
		$("#"+targetId).load(url, params, function(response, status, xhr){
			if(status == "error"){
				exception(xhr.status);
			}

		});
	}
	,loadWithSpin : function(targetId, url, params, popupYn){
		spin.start();
		
		if(params == undefined){
			params = {};
		}
		$("#"+targetId).load(url, params, function(response, status, xhr){
			spin.stop();
			if(status == "error"){
				exception(xhr.status);
			}

		});
	}
};

function exception(status){
	
	if (status == 0) {
		alert("네트워크를 상태를 확인해주십시오.");
	} else if (status == 401) {
		alert("서버에 접근하려면 인증이 필요합니다.");
	} else if (status == 403) {
		alert("서버에서 요청을 거부했습니다.");
	} else if (status == 404) {
		alert("지정하신 페이지를 찾을 수 없거나 오류가 발생했습니다.");
	} else if (status == 500) {
		alert("서버에서 작업 중 오류가 발생하였습니다.");
	} else if (status == 888) {
		alert("접근 권한이 부족합니다.");
		top.location.href = "/";
	} else if (status == 999) {
		alert("세션이 만료되었거나 정상적인 접근이 아닙니다.");
		top.location.href = "/";
	} else {
		alert("지정하신 작업을 처리하던 중, 알 수 없는 오류가 발생했습니다.");
	}
	
	if(status == "551"){
		location.href="/";
	}
}



var date = {
	getToday : function(){
		var date = new Date();
    	var now = date.getFullYear() + "-" + (date.getMonth() > 8 ? date.getMonth()+1 : "0"+(date.getMonth()+1)) + "-" + (date.getDate() > 9 ? date.getDate() : "0" + date.getDate()) ;
		return now;
	}
	, getFirstDayOfMonth : function(addMonth){
		
		var date = new Date();
		if(addMonth == undefined){
			addMonth = 0;
		}
		
		var firstDate = new Date(date.getFullYear(), date.getMonth() + addMonth, 1);
		
		var firstDay = firstDate.getFullYear() + "-" + (firstDate.getMonth() > 8 ? firstDate.getMonth()+1 : "0"+(firstDate.getMonth()+1)) + "-" + (firstDate.getDate() > 9 ? firstDate.getDate() : "0" + firstDate.getDate()) ;
		
		return firstDay;
	}
	, getDateStr : function(myDate){
		var year = myDate.getFullYear();
		var month = (myDate.getMonth() + 1);
		var day = myDate.getDate();
		
		Month = (Month < 10) ? "0" + String(Month) : Month;
		Day = (Day < 10) ? "0" + String(Day) : Day;
		
		return  (year + '-' + month + '-' + day );
	}, getTodayForOntology : function(){
		const today = new Date();
		return today.getFullYear() + ". " + (today.getMonth() + 1) + ". " + today.getDate() + ". ";
	}
	,
	/**
	 * 1주일전 날짜 반환
	 */ 
	lastWeek : function() {
		var d = new Date();
		var dayOfMonth = d.getDate();
		d.setDate(dayOfMonth - 7);
		return getDateStr(d);
	}
	, 
	/**
	 * 1개월전 날짜 반환
	 */ 
	lastMonth : function() {
		var d = new Date();
		var monthOfYear = d.getMonth();
		d.setMonth(monthOfYear - 1);
		return getDateStr(d);
	}
	/**
	 * 몇 개월 전
	 */
	,beforeMonth : function(termValue){
		var currentToday = new Date();
		var monthOfYear = currentToday.getMonth();
		currentToday.setMonth(monthOfYear - termValue);
		
		var currentDate = new Date();
		var fromDate = new Date(currentDate.setMonth(currentDate.getMonth() - termValue));
		return fromDate.getFullYear() + "-" + (fromDate.getMonth() > 8 ? fromDate.getMonth()+1 : "0"+(fromDate.getMonth()+1)) + "-" + (fromDate.getDate() > 9 ? fromDate.getDate() : "0" + fromDate.getDate()) ;
	}
	/**
	 * 현재 시간 얻기(yyyymmddhhmmss)
	 */
	,getCurrentTime : function(){
		var now = new Date();
		var res = "" + now.getFullYear() + date.padZero(now.getMonth() + 1) +
		date.padZero(now.getDate()) + date.padZero(now.getHours()) +
		date.padZero(now.getMinutes()) + date.padZero(now.getSeconds());
		
		return res;
	}
	,padZero : function(num) {
		return (num < 10 ? "0" : "") + num;
	}
}


/**
 * Object Deep Copy
 * @param obj
 * @returns
 */
function cloneObject(obj) {
	var clone = {};
	for(var i in obj) {
        if(typeof(obj[i])=="object" && obj[i] != null)
            clone[i] = cloneObject(obj[i]);
        else
            clone[i] = obj[i];
    }
    return clone;
}


