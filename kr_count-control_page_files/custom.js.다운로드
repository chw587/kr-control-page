// html unescpase
function unescapeHtml(str) {

	if (str == null) {
		return "";
	}

	return str

	.replace(/&amp;/g, '&')
	
	.replace(/&lt;/g, '<')
	
	.replace(/&gt;/g, '>')
	
	.replace(/&quot;/g, '"')
	
	.replace(/&#039;/g, "'")
	
	.replace(/&#39;/g, "'");

}

